---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Ultimate Vienna — Frisbee Club" current="home">
  <!-- Hero -->
  <section class="relative min-h-[520px] flex items-center justify-center overflow-hidden bg-primary">
    <div class="absolute inset-0 bg-cover bg-center opacity-35" style="background-image: url('/images/echorumble.jpg');"></div>
    <div class="relative z-1 text-center px-6 py-12 max-w-[700px]">
      <h1 class="text-5xl text-white mb-3 tracking-wide">Ultimate <span class="text-gold">Vienna</span></h1>
      <p class="text-[1.15rem] text-white/85 max-w-[540px] mx-auto">Vienna&rsquo;s ultimate frisbee community &mdash; competing with passion, playing with spirit, and growing the game since day one.</p>
    </div>
  </section>

  <!-- Team Cards -->
  <section class="max-w-[1120px] mx-auto px-6 py-16">
    <h2 class="font-heading text-4xl text-primary mb-2">Our Teams</h2>
    <p class="text-text-light text-[1.05rem] mb-10">Two teams, one club &mdash; find the one that fits you.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Echo / Rumble -->
      <a href="/teams/echo" class="block bg-surface rounded-lg overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-250">
        <div class="h-[220px] bg-cover bg-center bg-gray-300" style="background-image: url('/images/echo.jpeg');"></div>
        <div class="p-7">
          <span class="inline-block text-[.7rem] font-semibold uppercase tracking-widest text-white bg-accent px-3 py-1 rounded mb-3">Open</span>
          <h3 class="font-heading text-2xl text-primary mb-2">Echo / Rumble</h3>
          <p class="text-text-light text-[.95rem] mb-5">Our men&rsquo;s open team competing at the highest level. Built on discipline, athleticism, and relentless spirit.</p>
          <span class="team-link inline-flex items-center gap-1.5 font-semibold text-[.9rem] text-accent transition-all duration-250">Learn more &rarr;</span>
        </div>
      </a>

      <!-- Foxes -->
      <a href="/teams/foxes" class="block bg-surface rounded-lg overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-250">
        <div class="h-[220px] bg-cover bg-center bg-gray-300" style="background-image: url('/images/foxes.jpg');"></div>
        <div class="p-7">
          <span class="inline-block text-[.7rem] font-semibold uppercase tracking-widest bg-gold text-primary px-3 py-1 rounded mb-3">Youth</span>
          <h3 class="font-heading text-2xl text-primary mb-2">Foxes</h3>
          <p class="text-text-light text-[.95rem] mb-5">Our youth team &mdash; the next generation of ultimate players. Learning the game, building friendships, and having fun.</p>
          <span class="team-link inline-flex items-center gap-1.5 font-semibold text-[.9rem] text-accent transition-all duration-250">Learn more &rarr;</span>
        </div>
      </a>
    </div>

    <!-- Join CTA -->
    <!--<div class="mt-12 bg-surface rounded-lg p-8 shadow-sm border-l-4 border-accent flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">-->
    <!--  <div>-->
