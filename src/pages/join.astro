---
import BaseLayout from '../layouts/BaseLayout.astro';

const teams = [
  {
    slug: 'echo',
    name: 'Echo / Rumble',
    tag: 'Open',
    tagClass: 'text-white bg-accent',
    color: "accent",
    blurb: 'Our men`s open program — competitive and development squads.',
  },
  {
    slug: 'foxes',
    name: 'Foxes',
    tag: 'Youth',
    tagClass: 'bg-gold text-primary',
    color: "gold",
    blurb: 'Our youth team for players under 18 — fundamentals, fun, and friendship.',
  },
];
---

<BaseLayout title="Join — Ultimate Vienna" current="join">
  <section class="max-w-[1120px] mx-auto px-6 py-16">
    <h2 class="font-heading text-4xl text-primary mb-2">Join the club</h2>
    <p class="text-text-light text-[1.05rem] mb-10">Pick a team to start your registration. The form is the same either way — this just tells us which team you&rsquo;re joining.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {teams.map((t) => (
        <a href={`/join/${t.slug}`} class={`block bg-surface rounded-lg p-8 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-250 border-t-4 border-${t.color}`}>
          <span class={`inline-block text-[.7rem] font-semibold uppercase tracking-widest px-3 py-1 rounded mb-3 ${t.tagClass}`}>{t.tag}</span>
          <h3 class="font-heading text-2xl text-primary mb-2">{t.name}</h3>
          <p class="text-text-light text-[.95rem] mb-5">{t.blurb}</p>
          <span class="team-link inline-flex items-center gap-1.5 font-semibold text-[.9rem] text-accent transition-all duration-250">Register &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
