---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Imprint — Ultimate Vienna" current="imprint">
  <section class="max-w-[1120px] mx-auto px-6 py-16">
    <h2 class="font-heading text-4xl text-primary mb-2">Imprint</h2>
    <p class="text-text-light text-[1.05rem] mb-10">Legal disclosure as required by Austrian law (&sect; 5 ECG).</p>

    <div class="bg-surface rounded-lg p-8 shadow-sm mb-6">
      <h3 class="text-[1.1rem] text-primary mb-3 pb-2 border-b border-border">Club Information</h3>
      <p class="text-[.95rem] mb-1">Ultimate Vienna</p>
      <p class="text-[.95rem] mb-1">Bujattigasse 3/B/4</p>
      <p class="text-[.95rem]">1140 Vienna, Austria</p>
      <p class="text-[.95rem]">ZVR: 507159175</p>
    </div>

    <div class="bg-surface rounded-lg p-8 shadow-sm mb-6">
      <h3 class="text-[1.1rem] text-primary mb-3 pb-2 border-b border-border">Contact</h3>
      <p class="text-[.95rem]">Email: <a href="mailto:vorstand@ultimatevienna.net" class="text-accent hover:text-accent-light transition-colors duration-250">vorstand@ultimatevienna.net</a></p>
    </div>

    <div class="bg-surface rounded-lg p-8 shadow-sm mb-6">
      <h3 class="text-[1.1rem] text-primary mb-3 pb-2 border-b border-border">Disclaimer</h3>
      <p class="text-[.95rem]">The information provided on this website is for general informational purposes only. Ultimate Vienna makes no representations or warranties of any kind, express or implied, about the completeness, accuracy, reliability, or availability of the information, products, services, or related graphics contained on this website for any purpose.</p>
    </div>
  </section>
</BaseLayout>
