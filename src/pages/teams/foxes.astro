---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MembershipFeeCard from '../../components/MembershipFeeCard.astro';
---

<BaseLayout title="Foxes — Ultimate Vienna" current="foxes">
  <!-- Hero -->
  <section class="relative min-h-[340px] flex items-end overflow-hidden bg-primary">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('/images/foxes.jpg');"></div>
    <div class="relative z-1 max-w-[1120px] w-full mx-auto px-6 py-12">
      <span class="inline-block text-[.7rem] font-semibold uppercase tracking-widest bg-gold text-primary px-3 py-1 rounded mb-3">Youth</span>
      <h1 class="font-heading text-[2.5rem] text-white mb-1">Foxes</h1>
      <p class="text-white/75 text-[1.05rem]">Vienna&rsquo;s youth ultimate team</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-[1120px] mx-auto px-6 py-16">
    <h2 class="font-heading text-4xl text-primary mb-2">About the Team</h2>
    <p class="text-text-light text-[1.05rem] mb-10">Where young players find their game.</p>
    <p class="text-text-light leading-relaxed">
      The Foxes are Ultimate Vienna&rsquo;s youth team, open to players of all skill levels under 20. We focus on developing fundamentals, building confidence on the field, and fostering a love for the game. Our coaches emphasise teamwork, fair play, and most importantly &mdash; fun. Whether you want to compete at youth nationals or just throw a disc with friends, the Foxes are for you.
    </p>

    <!-- Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
      <div class="bg-surface rounded-lg p-7 shadow-sm border-l-4 border-gold">
        <h3 class="text-[1rem] font-semibold uppercase tracking-widest text-gold mb-3">Practice Times</h3>
        <ul class="list-none p-0">
          <li class="py-[.35rem] text-[.95rem]"><strong class="text-primary min-w-[80px] inline-block">Wed</strong> 16:00 &ndash; 18:00</li>
          <li class="pb-[.35rem]"><a href="https://maps.app.goo.gl/NvXsYaxWrgGAjeLN9" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-[.95rem] text-accent hover:text-accent-light transition-colors duration-250"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>Trendsportzentrum Meiereistraße 20, 1020 Wien</a></li>
        </ul>
      </div>

      <MembershipFeeCard
        accent="gold"
        amount="&euro; 150 / year"
        amount2="+ &euro; 20 / year ÖUV national association fee"
        description="Includes all training sessions over the entire year."
      />
    </div>

    <!-- Contact -->
    <div class="flex flex-col sm:flex-row gap-4 mt-6">
      <a href="/join/foxes" class="inline-flex items-center gap-2 px-5 py-[.65rem] rounded-lg font-semibold text-[.9rem] bg-accent text-white hover:bg-accent-light transition-colors duration-250">
        Join the Foxes
      </a>
      <a href="https://www.instagram.com/ultimateviennafoxes/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-[.65rem] rounded-lg font-semibold text-[.9rem] bg-transparent border-2 border-border text-text hover:border-accent hover:text-accent transition-colors duration-250">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        Instagram
      </a>
      <a href="mailto:jugend@ultimatevienna.at" class="inline-flex items-center gap-2 px-5 py-[.65rem] rounded-lg font-semibold text-[.9rem] bg-transparent border-2 border-border text-text hover:border-accent hover:text-accent transition-colors duration-250">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        jugend@ultimatevienna.at
      </a>
    </div>
  </section>
</BaseLayout>
