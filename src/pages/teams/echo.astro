---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MembershipFeeCard from '../../components/MembershipFeeCard.astro';
---

<BaseLayout title="Echo / Rumble — Ultimate Vienna" current="echo">
  <!-- Hero -->
  <section class="relative min-h-[340px] flex items-end overflow-hidden bg-primary">
    <div class="absolute inset-0 bg-cover bg-center opacity-30" style="background-image: url('/images/echo.jpeg');"></div>
    <div class="relative z-1 max-w-[1120px] w-full mx-auto px-6 py-12">
      <span class="inline-block text-[.7rem] font-semibold uppercase tracking-widest text-white bg-accent px-3 py-1 rounded mb-3">Open</span>
      <h1 class="font-heading text-[2.5rem] text-white mb-1">Echo / Rumble</h1>
      <p class="text-white/75 text-[1.05rem]">Vienna&rsquo;s men&rsquo;s open ultimate team</p>
    </div>
  </section>

  <!-- Intro -->
  <section class="max-w-[1120px] mx-auto px-6 py-16">
    <h2 class="font-heading text-4xl text-primary mb-2">About the Program</h2>
    <p class="text-text-light text-[1.05rem] mb-10">Two squads, one mission &mdash; competing with heart and spirit.</p>
    <p class="text-text-light leading-relaxed">
      Echo and Rumble form Ultimate Vienna&rsquo;s men&rsquo;s open program in collaboration with <a href="https://eoefc.at" target="_blank">EÖFC</a>. Echo is the competitive squad, while Rumble is the development team &mdash; both share the same values of commitment, dedication, and spirit of the game. Whether you&rsquo;re a seasoned player or just getting started, there&rsquo;s a place for you.

      Both teams practice together on mondays while wednesday and thursday practices are individual to each team
    </p>

    <!-- Split: Echo vs Rumble -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 my-10">

      <!-- Echo -->
      <div class="bg-surface rounded-lg p-8 shadow-sm border-t-4 border-accent">
        <h3 class="font-heading text-[1.5rem] text-primary mb-2">Echo</h3>
        <p class="text-text-light text-[.95rem] leading-relaxed">Our competitive men&rsquo;s open squad. Echo represents Ultimate Vienna at the highest level, competing in national and international tournaments.</p>
        <p class="text-[.85rem] text-accent mt-2 italic">Please contact us before attending Echo practice sessions.</p>

        <h4 class="text-[.75rem] font-semibold uppercase tracking-widest text-accent mt-5 mb-1">Practice Times</h4>
        <ul class="list-none p-0">
          <li class="py-[.35rem] text-[.95rem]"><strong class="text-primary min-w-[80px] inline-block">Monday</strong> 20:00 &ndash; 22:00</li>
          <li class="pb-[.35rem] border-b border-border"><a href="https://maps.app.goo.gl/Y66jveAAPdz4RMvE7" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-[.95rem] text-accent hover:text-accent-light transition-colors duration-250"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>KSV Rustenschacher Allee</a></li>
          <li class="py-[.35rem] text-[.95rem]"><strong class="text-primary min-w-[80px] inline-block">Wednesday</strong> 20:00 &ndash; 22:00</li>
          <li class="pb-[.35rem]"><a href="https://maps.app.goo.gl/NvXsYaxWrgGAjeLN9" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-[.95rem] text-accent hover:text-accent-light transition-colors duration-250"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>Trendsportzentrum Meiereistraße 20, 1020 Wien</a></li>
        </ul>
      </div>

      <!-- Rumble -->
      <div class="bg-surface rounded-lg p-8 shadow-sm border-t-4 border-accent">
        <h3 class="font-heading text-[1.5rem] text-primary mb-2">Rumble</h3>
        <p class="text-text-light text-[.95rem] leading-relaxed">Our development squad, designed for players who are building their skills and working their way toward competitive play. Rumble offers dedicated coaching staff and focussed on growth and fundamentals.</p>

        <h4 class="text-[.75rem] font-semibold uppercase tracking-widest text-accent mt-5 mb-1">Practice Times</h4>
        <ul class="list-none p-0">
          <li class="py-[.35rem] text-[.95rem]"><strong class="text-primary min-w-[80px] inline-block">Monday</strong> 20:00 &ndash; 22:00</li>
          <li class="pb-[.35rem] border-b border-border"><a href="https://maps.app.goo.gl/Y66jveAAPdz4RMvE7" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-[.95rem] text-accent hover:text-accent-light transition-colors duration-250"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>KSV Rustenschacher Allee</a></li>
          <li class="py-[.35rem] text-[.95rem]"><strong class="text-primary min-w-[80px] inline-block">Thursday</strong> 20:00 &ndash; 22:00</li>
          <li class="pb-[.35rem]"><a href="https://maps.app.goo.gl/Y66jveAAPdz4RMvE7" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-[.95rem] text-accent hover:text-accent-light transition-colors duration-250"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>KSV Rustenschacher Allee</a></li>
        </ul>
      </div>

    </div>

    <!-- Membership Fee -->
    <MembershipFeeCard
      amount="&euro; 190 / year (&euro; 130 for students)"
      amount2="+ &euro; 30 / year Kooperationsystem fee"
      amount3="+ &euro; 20 / year ÖUV national association fee"
      description="Includes all training sessions for both teams over the entire season."
      class="mt-8"
    />

    <!-- Contact -->
    <div class="flex flex-col sm:flex-row gap-4 mt-6">
      <a href="/join/echo" class="inline-flex items-center gap-2 px-5 py-[.65rem] rounded-lg font-semibold text-[.9rem] bg-accent text-white hover:bg-accent-light transition-colors duration-250">
        Join Echo / Rumble
      </a>
      <a href="https://www.instagram.com/echo.rumble/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-[.65rem] rounded-lg font-semibold text-[.9rem] bg-transparent border-2 border-border text-text hover:border-accent hover:text-accent transition-colors duration-250">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        Instagram
      </a>
      <a href="mailto:echo@ultimatevienna.net" class="inline-flex items-center gap-2 px-5 py-[.65rem] rounded-lg font-semibold text-[.9rem] bg-transparent border-2 border-border text-text hover:border-accent hover:text-accent transition-colors duration-250">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        vorstand@ultimatevienna.net
      </a>
    </div>
  </section>
</BaseLayout>
