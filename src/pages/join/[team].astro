---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinForm from '../../components/JoinForm.vue';
import MembershipFeeCard from "../../components/MembershipFeeCard.astro";

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { team: 'echo' }, props: { title: 'Join Echo / Rumble — Ultimate Vienna', heading: 'Join Echo / Rumble' } },
    { params: { team: 'foxes' }, props: { title: 'Join the Foxes — Ultimate Vienna', heading: 'Join the Foxes' } },
  ];
}

const team = Astro.params.team as 'echo' | 'foxes';
const { title, heading } = Astro.props;
---

<BaseLayout title={title} current="join">
  <section class="max-w-[640px] mx-auto px-6 py-16">
    <h2 class="font-heading text-4xl text-primary mb-2">{heading}</h2>
    <p class="text-text-light text-[1.05rem] mb-4">Fill in your details and we&rsquo;ll get you started. Fields marked with * are required.</p>

    {team === "echo" &&
            <div class="mb-8">
      <p class="text-text-light text-[1.05rem] mb-2">A few important pieces of <b>information</b> first:</p>
                After completing the registration, <b>you will be assigned to one primary club automatically</b>. That can be either Ultimate Vienna or EÖFC - this is part of the symbiosis agreement that was made when both clubs created Echo & Rumble together.
                <br>
                This means that you will pay you main membership fee for either one of the clubs, and then a 30€ "Symbiosepauschale" to the other club. This makes you a full member of both clubs for the price of one membership.
                <br>
                That means <b>you have to make two bank transfers</b> to be a Echo/Rumble member, but other than the transfer recipient, everything else is the same for everybody.
                </div>
      }

    {team === "echo" ?
      <!-- Membership Fee -->
      <MembershipFeeCard
              amount="&euro; 190 / year"
              amount2="+ &euro; 30 / year Kooperationsystem fee"
              amount3="+ &euro; 20 / year ÖUV national association fee"
              description="Includes all training sessions over the entire season."
              class="my-8"
      />
      :
            <MembershipFeeCard
                    accent="gold"
                    amount="&euro; 150 / year"
                    amount2="+ &euro; 20 / year ÖUV national association fee"
                    description="Includes all training sessions over the entire year."
                    class="my-8"
            />
    }

    <div class:list={["bg-surface rounded-lg p-7 shadow-sm border-l-4", {'border-accent': team === 'echo', 'border-gold': team !== "echo"}]}>
      <JoinForm team={team} client:load />
    </div>
  </section>
</BaseLayout>
