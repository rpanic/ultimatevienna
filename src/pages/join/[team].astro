---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinForm from '../../components/JoinForm.vue';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { team: 'echo' }, props: { title: 'Join Echo / Rumble — Ultimate Vienna', heading: 'Join Echo / Rumble' } },
    { params: { team: 'foxes' }, props: { title: 'Join the Foxes — Ultimate Vienna', heading: 'Join the Foxes' } },
  ];
}

const team = Astro.params.team as 'echo' | 'foxes';
const { title, heading } = Astro.props;
---

<BaseLayout title={title} current="join">
  <section class="max-w-[640px] mx-auto px-6 py-16">
    <h2 class="font-heading text-4xl text-primary mb-2">{heading}</h2>
    <p class="text-text-light text-[1.05rem] mb-8">Fill in your details and we&rsquo;ll get you started. Fields marked with * are required.</p>

    <div class="bg-surface rounded-lg p-7 shadow-sm border-l-4 border-accent">
      <JoinForm team={team} client:load />
    </div>
  </section>
</BaseLayout>