---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WelcomeMessage from '../../../components/WelcomeMessage.vue';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { team: 'echo' } },
    { params: { team: 'foxes' } },
  ];
}

const team = Astro.params.team as 'echo' | 'foxes';
---

<BaseLayout title="Welcome — Ultimate Vienna" current="join">
  <section class="max-w-[640px] mx-auto px-6 py-16">
    <p class="text-accent text-[.8rem] font-semibold uppercase tracking-widest mb-2">Registration received</p>

    <div class="bg-surface rounded-lg p-8 shadow-sm border-l-4 border-accent mb-6">
      <WelcomeMessage team={team} client:load />
    </div>

    <a href="/" class="inline-flex items-center px-6 py-[.65rem] rounded-lg font-semibold text-[.9rem] bg-accent text-white hover:bg-accent-light transition-colors duration-250">
      &larr; Back to home
    </a>
  </section>
</BaseLayout>