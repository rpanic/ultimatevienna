---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MembershipSummary from '../../../emails/MembershipSummary.astro';
import { getResult } from '../../../lib/resultStore';

// On-demand so we can read the result token from the query string at request
// time (the onboarding action stashed the membership summary under it).
export const prerender = false;

const team = Astro.params.team;
if (team !== 'echo' && team !== 'foxes') {
  return Astro.redirect('/404');
}

const token = Astro.url.searchParams.get('t');
const info = getResult(token);
---

<BaseLayout title="Registration received — Ultimate Vienna" current="join">
  <section class="max-w-[640px] mx-auto px-6 py-16">
    <p class="text-accent text-[.8rem] font-semibold uppercase tracking-widest mb-4">Registration received</p>

    {info ? (
      <div class="mb-8">
        <MembershipSummary info={info} />
      </div>
    ) : (
      <div class="bg-surface rounded-lg p-8 shadow-sm border-l-4 border-accent mb-8">
        <p class="text-text leading-relaxed">
          Thanks for registering! We&rsquo;ve received your details and sent the
          payment information to your email. If you don&rsquo;t see it shortly,
          check your spam folder or write to
          <a href="mailto:vorstand@ultimatevienna.net" class="text-accent font-semibold">vorstand@ultimatevienna.net</a>.
        </p>
      </div>
    )}

    <a href="/" class="inline-flex items-center px-6 py-[.65rem] rounded-lg font-semibold text-[.9rem] bg-accent text-white hover:bg-accent-light transition-colors duration-250">
      &larr; Back to home
    </a>
  </section>
</BaseLayout>