---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReimbursementSummary from '../../emails/ReimbursementSummary.astro';
import { getReimburse } from '../../lib/reimbursement/reimburseStore';
import type { ReimburseEmailSummary } from '../../lib/reimbursement/reimburse';

// On-demand so we can read the result token from the query string at request
// time (the submit endpoint stashed the submission summary under it). Reuses the
// same ReimbursementSummary card as the submitter confirmation email (member
// variant) so the done page and the email always show the same thing — mirrors
// the join flow's MembershipSummary reuse.
export const prerender = false;

const token = Astro.url.searchParams.get('t');
const info = getReimburse(token);

// Build the shared summary shape from the stashed submission. The member variant
// shows the receipt count (no Drive links — the member can't access the folder),
// and surfaces the dry-run note via receiptUploaded.
const summary: ReimburseEmailSummary | null = info
  ? {
      id: info.id,
      submitterName: info.submitterName,
      submitterEmail: info.submitterEmail,
      expenseDate: info.expenseDate,
      description: info.description,
      total: info.total,
      split: info.split,
      payoutMethod: info.payoutMethod,
      receiptCount: info.receiptCount,
      receiptLinks: [],
      receiptUploaded: info.receiptUploaded,
    }
  : null;
---

<BaseLayout title="Reimbursement submitted — Ultimate Vienna" current="reimburse">
  <section class="max-w-[640px] mx-auto px-6 py-16">
    <p class="text-accent text-[.8rem] font-semibold uppercase tracking-widest mb-4">Request submitted</p>

    {summary ? (
      <div class="mb-8">
        <ReimbursementSummary summary={summary} variant="member" />
      </div>
    ) : (
      <div class="bg-surface rounded-lg p-8 shadow-sm border-l-4 border-accent mb-8">
        <p class="text-text leading-relaxed">
          Thanks &mdash; we&rsquo;ve received your request and sent a confirmation to your
          email. If you don&rsquo;t see it shortly, check your spam folder or write to
          <a href="mailto:vorstand@ultimatevienna.net" class="text-accent font-semibold">vorstand@ultimatevienna.net</a>.
        </p>
      </div>
    )}

    <a href="/" class="inline-flex items-center px-6 py-[.65rem] rounded-lg font-semibold text-[.9rem] bg-accent text-white hover:bg-accent-light transition-colors duration-250">
      &larr; Back to home
    </a>
  </section>
</BaseLayout>