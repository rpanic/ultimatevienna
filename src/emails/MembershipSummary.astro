---
import type { MembershipInfo } from '../lib/membership';

// The membership summary card: personal data + payment breakdown + bank
// accounts + total. Shared by the printable email (MembershipEmail.astro wraps
// this in a full HTML document) and the post-registration result screen
// (src/pages/join/[team]/done.astro), so the two always show the same thing.
//
// Styles are inline because the email needs them; they render fine in the
// browser too.
const { info } = Astro.props as { info: MembershipInfo };

const money = (n: number) => `${n.toFixed(2).replace('.', ',')} €`;
const teamLabel = info.team === 'foxes' ? 'Foxes' : 'Echo / Rumble';
const fullName = `${info.member.firstName} ${info.member.lastName}`;
const YES = 'ja';
const NO = 'nein';
---

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px rgba(0,0,0,.08);border-collapse:separate;">
  <!-- Header -->
  <tr>
    <td style="background:#1f7a52;padding:24px 32px;">
      <h1 style="margin:0;color:#ffffff;font-size:20px;font-weight:700;">Ultimate Vienna</h1>
      <p style="margin:4px 0 0;color:#eafff4;font-size:13px;">Mitgliedschaft {info.season} — {teamLabel}</p>
    </td>
  </tr>

  <tr><td style="padding:24px 32px 0;">

    <!-- Greeting -->
    <p style="margin:0 0 16px;font-size:15px;">Hallo {info.member.firstName},</p>
    <p style="margin:0 0 24px;font-size:15px;line-height:1.5;">
      willkommen bei Ultimate Vienna! Hier ist die Zusammenfassung deiner
      Registrierung und die Zahlungsdaten für deinen Mitgliedsbeitrag
      (Saison {info.season}).
    </p>

    <!-- Member data -->
    <h2 style="margin:0 0 12px;font-size:14px;text-transform:uppercase;letter-spacing:.05em;color:#5b6b7a;">Persönliche Daten</h2>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;line-height:1.5;border-collapse:collapse;">
      <tr><td style="padding:4px 0;color:#5b6b7a;width:180px;">Name</td><td style="padding:4px 0;">{fullName}</td></tr>
      <tr><td style="padding:4px 0;color:#5b6b7a;">E-Mail</td><td style="padding:4px 0;">{info.member.email}</td></tr>
      <tr><td style="padding:4px 0;color:#5b6b7a;">Geburtsdatum</td><td style="padding:4px 0;">{info.member.birthDate}</td></tr>
      {info.member.phone && <tr><td style="padding:4px 0;color:#5b6b7a;">Telefon</td><td style="padding:4px 0;">{info.member.phone}</td></tr>}
      {info.member.address && <tr><td style="padding:4px 0;color:#5b6b7a;">Adresse</td><td style="padding:4px 0;">{info.member.address}</td></tr>}
      {info.member.otherClubs && <tr><td style="padding:4px 0;color:#5b6b7a;">Andere Vereine</td><td style="padding:4px 0;">{info.member.otherClubs}</td></tr>}
      <tr><td style="padding:4px 0;color:#5b6b7a;">Nationalverband</td><td style="padding:4px 0;">UVie übernimmt die ÖBV-Gebühr: {info.member.payNationalFee ? YES : NO}</td></tr>
      {info.assignedClub && <tr><td style="padding:4px 0;color:#5b6b7a;">Zugewiesener Verein</td><td style="padding:4px 0;">{info.assignedClub}</td></tr>}
    </table>

  </td></tr>

  <!-- Payments -->
  <tr><td style="padding:24px 0 0;" colspan="2">
    <h2 style="margin:0 0 12px;font-size:14px;text-transform:uppercase;letter-spacing:.05em;color:#5b6b7a;">Zahlungsübersicht</h2>
  </td></tr>

  {info.payments.map((p) => (
    <tr><td colspan="2">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #e6eaef;border-radius:8px;border-collapse:separate;margin-bottom:14px;">
        <tr>
          <td style="padding:14px 16px;">
            <p style="margin:0 0 2px;font-size:15px;font-weight:600;color:#1f2933;">{p.purpose}</p>
            <p style="margin:0;font-size:13px;color:#5b6b7a;">Zahlung an: {p.club}</p>
          </td>
          <td align="right" style="padding:14px 16px;vertical-align:top;">
            <span style="font-size:18px;font-weight:700;color:#1f7a52;white-space:nowrap;">{money(p.amount)}</span>
          </td>
        </tr>
        <tr>
          <td colspan="2" style="padding:0 16px 14px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:13px;line-height:1.5;background:#f8fafb;border-radius:6px;">
              <tr><td style="padding:8px 10px;color:#5b6b7a;width:90px;">Kontoinhaber</td><td style="padding:8px 10px;">{p.account.holder}</td></tr>
              <tr><td style="padding:4px 10px;color:#5b6b7a;">IBAN</td><td style="padding:4px 10px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">{p.account.iban}</td></tr>
              <tr><td style="padding:4px 10px;color:#5b6b7a;">BIC</td><td style="padding:4px 10px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">{p.account.bic}</td></tr>
              <tr><td style="padding:4px 10px;color:#5b6b7a;">Bank</td><td style="padding:4px 10px;">{p.account.bank}</td></tr>
            </table>
          </td>
        </tr>
      </table>
    </td></tr>
  ))}

  <tr><td style="padding:8px 32px 24px;" colspan="2">
    <p style="margin:0;font-size:12px;color:#5b6b7a;line-height:1.5;">
      Bitte überweise den Betrag auf die angegebenen Konten. Als
      Verwendungszweck empfiehlt sich: <em>{fullName} — {info.season}</em>.
    </p>
  </td></tr>

  <!-- Footer -->
  <tr><td style="background:#f4f5f7;padding:16px 32px;border-top:1px solid #e6eaef;" colspan="2">
    <p style="margin:0;font-size:12px;color:#5b6b7a;">
      Ultimate Vienna · vorstand@ultimatevienna.net<br />
      Fragen zur Mitgliedschaft? Antworte einfach auf diese E-Mail.
    </p>
  </td></tr>
</table>
