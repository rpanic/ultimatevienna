---
import type { MembershipInfo } from '../lib/membership';
import MembershipSummary from './MembershipSummary.astro';

// Full HTML document wrapper around the shared MembershipSummary card. Used by
// renderMembershipEmail() to produce the printable email string. The visible
// content lives in MembershipSummary.astro so the result screen can render the
// exact same thing.
const { info } = Astro.props as { info: MembershipInfo };
const teamLabel = info.team === 'foxes' ? 'Foxes' : 'Echo / Rumble';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ultimate Vienna — Mitgliedschaft {teamLabel} {info.season}</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2933;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:24px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:100%;">
            <tr><td><MembershipSummary info={info} /></td></tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>