---
const year = new Date().getFullYear();
---

<footer class="bg-primary text-white/70 py-10 px-6 mt-8">
  <div class="max-w-[1120px] mx-auto flex flex-wrap justify-between items-center gap-4">
    <div class="flex items-center gap-4">
      <img src="/images/sportunion-light.png" alt="Sportunion" class="h-10">
      <p class="text-[.85rem]">&copy; {year} Ultimate Vienna</p>
    </div>
    <ul class="flex gap-6 list-none">
      <li><a href="/imprint" class="text-white/70 text-[.85rem] hover:text-gold transition-colors duration-250">Imprint</a></li>
    </ul>
  </div>
</footer>