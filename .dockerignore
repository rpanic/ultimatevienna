# Keep build context small and prevent secrets / local artifacts from entering
# the image. The build stage runs `npm ci` itself, so node_modules is not needed.
node_modules
dist
.astro

# Never bake real secrets into the image — pass them at runtime via
# `docker run --env-file .env` or -e flags.
.env
.env.*
!.env.example

.git
.gitignore
Dockerfile
.dockerignore
*.log
.DS_Store