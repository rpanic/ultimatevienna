# Google Sheets backend configuration.
# Copy this file to ".env" and fill in the values for local development.
# In production, set the same variables in the host environment (the Node adapter
# reads them from process.env at runtime).
#
# How to get these:
# 1. Google Cloud Console > APIs & Services > enable "Google Sheets API".
# 2. IAM & Admin > Service Accounts > create a service account > generate a JSON key.
# 3. Copy the "client_email" and "private_key" from that JSON below.
# 4. Open your spreadsheet, share it with the service account email as Editor.
# 5. Copy the spreadsheet ID from the sheet URL:
#       https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
#
# The spreadsheet needs TWO tabs (one per team; team is implied by the tab,
# there is no Team column):
#
# "EchoRumble" tab and "Foxes" tab — header row in this exact column order:
#   A Timestamp | B FirstName | C LastName | D Email | E BirthDate
#   F Phone | G Address | H OtherClubs | I PayNationalFee | J Student
#   K Club | L Status | M AlreadyPaidClub | N AlreadyPaidSymbiose
#   (Club is the assigned club, suffixed " - alt" when the member already paid
#   that club's fee this season; Status is "claimed" then, else "pending". The
#   literal alreadyPaidClub choice — none / UVie / EÖFC — is encoded in Club +
#   Status, not written as a separate column. M is written "claimed"/"pending"
#   to reflect the second checkbox — whether the Symbiosepauschale was already
#   paid too (always "pending" for foxes); N is reserved and not written.)
#
# The post-onboarding welcome message is generated by the welcomeMessage action
# in src/actions/index.ts (generateWelcomeMessage), not read from the sheet.

GOOGLE_SHEETS_SPREADSHEET_ID=
# The service account email from the JSON key file — it ends in
# ".iam.gserviceaccount.com" (NOT a personal email). It must come from the SAME
# key file as GOOGLE_SHEETS_PRIVATE_KEY below.
GOOGLE_SHEETS_CLIENT_EMAIL=
# The "private_key" field from that JSON key file. Accepts either the full PEM
# (-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----) or the bare base64
# body, with literal "\n" escapes or real newlines — it is normalized to a valid
# PEM automatically.
GOOGLE_SHEETS_PRIVATE_KEY=

# Optional: members tab names inside the spreadsheet per team
# (defaults: EchoRumble, Foxes). Team is implied by which tab a row lives on.
MEMBERS_SHEET_TAB_ECHO=EchoRumble
MEMBERS_SHEET_TAB_FOXES=Foxes

# --- Credit sheet (outstanding UVie debts) ---
# Optional. A SEPARATE spreadsheet (the club ledger) used to collect outstanding
# debts on registration. The layout is TRANSPOSED:
#   - Row 1 (header): A "Guthaben", then team/section labels ("Echo", "Rumble",
#     "Neu/Alt/External", "EÖFC", "UVie") with one MEMBER NAME per column in
#     between — each member occupies their own column.
#   - Column A: row labels. The row labeled "Guthabenstand" holds each member's
#     signed balance (deposits − their share of spending) — a formula whose
#     computed value is read.
# On registration the member's full name is matched against the header to find
# their column (order-independent: "First Last", "Last First", "Last, First" all
# match), then the "Guthabenstand" cell is read. A NEGATIVE balance means the
# member owes UVie → the positive debt is added as a line item to the UVie
# payment. Zero/positive (paid up, or UVie owes them) → nothing is added.
# The same service account (GOOGLE_SHEETS_CLIENT_EMAIL) must have Editor access
# to this spreadsheet too — share it with that email. When the spreadsheet ID is
# unset the feature is off and the lookup silently does nothing.
CREDIT_SHEET_SPREADSHEET_ID=
# Optional: the tab name in the credit spreadsheet. If unset, the first tab is
# used (range A:ZZ — the full width, since members are columns).
CREDIT_SHEET_TAB=

# --- Debt sheet "already invoiced" markers (same credit/debt spreadsheet) ---
# Optional. The credit/debt sheet also has, in column A, four extra row labels
# marking — per member (column) — that a UVie item has already been added to
# their debt, so we don't invoice it again on registration. A member's cell at
# the labelled row containing the number 1 means "already invoiced" (German
# formatting like "1,00" is tolerated).
#   - DEBT_ROW_FULL_MEMBERSHIP     → the UVie full membership fee is dropped.
#   - DEBT_ROW_REDUCED_MEMBERSHIP  → the UVie reduced (student) membership fee
#                                    is dropped (the "(ermäßigt)" item).
#   - DEBT_ROW_SYMBIOSEPAUSCHALE   → the Symbiosepauschale is dropped, but ONLY
#                                    when it is the one owed to UVie (member
#                                    assigned to EÖFC, so symbiose → UVie).
#   - DEBT_ROW_NATIONAL_FEE        → the ÖUV national federation fee is
#                                    dropped, but ONLY when it is owed to UVie
#                                    (foxes, or echo assigned to UVie — the fee
#                                    is paid to the assigned club).
# The member's column is found by the same order-independent header match as
# the credit lookup. When all four are unset (or the credit sheet is off) the
# feature is off and nothing is dropped. Leave a value blank to disable just
# that one row.
DEBT_ROW_FULL_MEMBERSHIP=
DEBT_ROW_REDUCED_MEMBERSHIP=
DEBT_ROW_SYMBIOSEPAUSCHALE=
DEBT_ROW_NATIONAL_FEE=

# --- Email (Resend API) ---
# Used by sendEmail() in src/lib/email.ts (e.g. the status action emails the
# member's status to their own address). When RESEND_API_KEY is unset, sendEmail()
# runs in a dry-run mode and just logs instead of sending.
#
# Get an API key at https://resend.com/api-keys (starts with "re_"). The sender
# domain in MAIL_FROM must be verified in Resend (Domains > Add domain), otherwise
# sends will be rejected.
RESEND_API_KEY=

# Optional: sender address (default shown). Domain must be verified in Resend.
MAIL_FROM=Ultimate Vienna <no-reply@ultimatevienna.net>

# --- Club bank accounts (membership payments) ---
# Shown in the registration email + result screen so members know where to
# transfer. Non-secret org data, but server-side only (never in the client
# bundle). When unset, placeholder values ("TODO IBAN", …) are used so the site
# stays demoable. Set per club: UVIE_BANK_* and EOFC_BANK_*.
UVIE_BANK_HOLDER=
UVIE_BANK_IBAN=
UVIE_BANK_BIC=
EOFC_BANK_HOLDER=
EOFC_BANK_IBAN=
EOFC_BANK_BIC=

NOTIFICATION_EMAIL=
